# YouTube Data API v3 key — used at build time to fetch recent uploads for /videos.
# Create one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
# The channel ID lives in src/consts.ts (YOUTUBE_CHANNEL_ID).
YOUTUBE_API_KEY=AIzaSyCNt7ehe0xGAKGgf5t212J_3kr1i4MFXsc

# Keystatic CMS – GitHub App (required for production/Cloudflare Pages)
#
# The easiest setup: run the dev server, go to /keystatic, click "GitHub" login,
# and follow the wizard — it creates the GitHub App and writes these values to .env for you.
#
# Manual setup (alternative):
# 1. Go to https://github.com/settings/apps → "New GitHub App"
# 2. Set Callback URL to: https://your-domain.com/api/keystatic/github/oauth/callback
# 3. Enable "Request user authorization (OAuth) during installation"
# 4. Copy the App ID (used as Client ID) and generate a Private Key (Client Secret)
# 5. Add all variables below to your Cloudflare Pages dashboard environment variables
#
# For local dev, none of these are needed — Keystatic runs in local mode automatically.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# The slug (name) of the GitHub App — shown on the app's GitHub settings page
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Random secret for session signing — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=
