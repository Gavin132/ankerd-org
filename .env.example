# YouTube Data API v3 key — used at build time to fetch recent uploads for /videos.
# Create one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
# The channel ID lives in src/consts.ts (YOUTUBE_CHANNEL_ID).
YOUTUBE_API_KEY=

# Keystatic CMS – GitHub OAuth (required for production/Cloudflare Pages)
#
# 1. Go to https://github.com/settings/developers → "OAuth Apps" → "New OAuth App"
# 2. Set Homepage URL to your domain (e.g. https://ankerd.org)
# 3. Set Callback URL to: https://your-domain.com/api/keystatic/github/oauth/callback
# 4. Copy the Client ID and generate a Client Secret below
# 5. Add these as environment variables in your Cloudflare Pages dashboard
#
# For local dev, none of these are needed — Keystatic runs in local mode automatically.

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random secret for session signing — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=
