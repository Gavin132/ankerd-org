---
import VideoCard from '../components/VideoCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { getRecentVideos } from '../lib/youtube';

const allVideos = await getRecentVideos();
const videos = allVideos?.filter((v) => !v.isShort) ?? null;
const shorts = allVideos?.filter((v) => v.isShort) ?? [];
---

<BaseLayout title={`Videos — ${SITE_TITLE}`} description="Recent YouTube uploads by ankerd." wide>
	<h1>Videos</h1>
	{
		videos && videos.length > 0 ? (
			<div class="grid">
				{videos.map((video, i) => (
					<div class:list={{ featured: i === 0 }}>
						<VideoCard video={video} loading={i < 6 ? 'eager' : 'lazy'} />
					</div>
				))}
			</div>
		) : (
			<div class="empty">
				<p>Videos are coming soon.</p>
				{import.meta.env.DEV && (
					<p class="dev-note">
						Dev note: set <code>YOUTUBE_API_KEY</code> in <code>.env</code> and{' '}
						<code>YOUTUBE_CHANNEL_ID</code> in <code>src/consts.ts</code> to load uploads here.
					</p>
				)}
			</div>
		)
	}

	{
		shorts.length > 0 && (
			<section class="shorts-section">
				<div class="section-header">
					<div class="section-label">Shorts</div>
				</div>
				<div class="shorts-grid">
					{shorts.map((video) => (
						<VideoCard video={video} short />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>

<style>
	h1 {
		font-size: 2.441em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5em 1.25em;
	}
	/* Newest video fills a 2x2 block of tiles */
	.featured {
		grid-column: span 2;
		grid-row: span 2;
	}
	@media (max-width: 640px) {
		.featured {
			grid-column: auto;
			grid-row: auto;
		}
	}
	.empty {
		padding: 2em;
		background: var(--bg-alt);
		border: 1px dashed var(--border);
		border-radius: 12px;
		color: var(--text-muted);
		text-align: center;
	}
	.empty p {
		margin: 0;
	}
	.dev-note {
		margin-top: 0.75em !important;
		font-size: 0.8em;
	}

	.shorts-section {
		margin-top: 3.5em;
	}
	.section-header {
		margin-bottom: 1.25em;
	}
	.section-label {
		font-size: 0.7em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-muted);
		position: relative;
		padding-left: 1.2em;
	}
	.section-label::before {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 0.6em;
		height: 0.6em;
		border-radius: 50%;
		background: var(--accent);
	}
	/* Shorts are vertical (9:16), so narrower cards */
	.shorts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1.25em 1em;
	}
</style>
