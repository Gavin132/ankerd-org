---
import { Icon } from 'astro-icon/components';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import GalleryCard from '../components/GalleryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Pre-generate full-size URLs for the lightbox
const photosFull = await Promise.all(
	photos.map(async (entry) => {
		const full = await getImage({ src: entry.data.photo, width: 1600 });
		const meta = [entry.data.camera, entry.data.lens, entry.data.settings].filter(Boolean).join(' · ');
		return { entry, fullSrc: full.src, meta };
	})
);
---

<BaseLayout title={`Gallery — ${SITE_TITLE}`} description="3D renders by ankerd." wide>
	<div class="gallery-header" data-animate>
		<h1>Gallery</h1>
		<div class="layout-toggle" role="group" aria-label="Gallery layout">
			<button class="layout-btn active" data-layout="grid" title="Grid view" aria-pressed="true">
				<Icon name="lucide:layout-grid" width="16" height="16" aria-hidden="true" />
			</button>
			<button class="layout-btn" data-layout="stack" title="Editorial view" aria-pressed="false">
				<Icon name="lucide:rows-2" width="16" height="16" aria-hidden="true" />
			</button>
		</div>
	</div>

	{photos.length > 0 ? (
		<>
			{/* Stack / editorial alternating layout */}
			<div class="stack-layout hidden" id="stack-layout">
				{photosFull.map(({ entry, fullSrc, meta }, i) => (
					<button
						class="stack-item"
						data-full={fullSrc}
						data-title={entry.data.title}
						data-description={entry.data.description ?? ''}
						data-meta={meta}
						data-alt={entry.data.alt}
						data-animate
						data-delay={Math.min((i % 3) + 1, 3)}
						style={i % 2 === 0 ? 'flex-direction: row-reverse;' : 'flex-direction: row;'}
					>
						<div class="stack-img">
							<Image
								src={entry.data.photo}
								alt={entry.data.alt}
								widths={[800, 1200, 1600]}
								sizes="(max-width: 720px) 100vw, 42vw"
								loading={i < 2 ? 'eager' : 'lazy'}
							/>
						</div>
						<div class="stack-info">
							<h2 class="stack-title">{entry.data.title}</h2>
							{entry.data.description && <p class="stack-desc">{entry.data.description}</p>}
							{meta && <p class="stack-meta">{meta}</p>}
							<span class="stack-date"><FormattedDate date={entry.data.date} /></span>
						</div>
					</button>
				))}
			</div>

			{/* Grid layout */}
			<div class="grid-layout" id="grid-layout">
				{photos.map((entry, i) => (
					<div class="gallery-item" data-animate data-delay={Math.min(i + 1, 5)}>
						<GalleryCard entry={entry} loading={i < 4 ? 'eager' : 'lazy'} />
					</div>
				))}
			</div>
		</>
	) : (
		<p class="empty">No photos yet — add entries to <code>src/content/gallery/</code>.</p>
	)}

	<dialog id="lightbox">
		<button class="close" aria-label="Close">&times;</button>
		<img alt="" />
		<div class="info">
			<h2 class="lb-title"></h2>
			<p class="lb-description"></p>
			<p class="lb-meta"></p>
		</div>
	</dialog>
</BaseLayout>

<style>
	.gallery-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 2em;
	}
	/* Keep the layout toggle clear of the fixed theme button (top-right on desktop). */
	@media (min-width: 721px) {
		.gallery-header {
			padding-right: 1.5rem;
		}
	}
	h1 {
		font-size: 2.441em;
		margin: 0;
	}

	.layout-toggle {
		display: flex;
		gap: 0.35em;
		background: var(--bg-alt);
		border: 1.5px solid var(--border);
		border-radius: 8px;
		padding: 0.25em;
	}
	.layout-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border: none;
		background: none;
		border-radius: 6px;
		color: var(--text-muted);
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.layout-btn.active {
		background: var(--bg);
		color: var(--accent);
		box-shadow: 0 0 0 1.5px var(--outline);
	}
	.layout-btn:hover:not(.active) { color: var(--text); }

	/* ── Editorial / stack layout ─────────────────── */
	.stack-layout {
		display: flex;
		flex-direction: column;
		gap: 0;
	}
	.stack-item {
		display: flex;
		align-items: stretch;
		gap: 0;
		width: 100%;
		background: none;
		border: none;
		padding: 1.5em 0;
		cursor: zoom-in;
		text-align: left;
		color: var(--text);
		font: inherit;
	}
	.stack-item:first-child { border-top: none; }

	.stack-img {
		flex: 0 0 42%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 12px;
		position: relative;
	}
	.stack-img::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(15, 21, 25, 0.2);
		border-radius: 12px;
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.stack-item:hover .stack-img::after { opacity: 1; }
	.stack-img img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: unset;
		border-radius: 12px;
		transition: transform 0.5s ease;
	}

	.stack-info {
		flex: 1;
		padding: 1em 2em;
		justify-content: center;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.stack-title {
		font-size: 1.4em;
		line-height: 1.2;
		margin: 0;
		color: var(--text);
	}
	.stack-desc {
		font-size: 0.9em;
		color: var(--text-muted);
		line-height: 1.55;
		margin: 0;
	}
	.stack-meta {
		font-size: 0.78em;
		color: var(--text-muted);
		opacity: 0.7;
		margin: 0;
		font-style: italic;
	}
	.stack-date {
		font-size: 0.75em;
		color: var(--text-muted);
		opacity: 0.55;
		margin-top: 0.5em;
	}

	/* ── Grid layout ──────────────────────────────── */
	.grid-layout {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.25em;
	}
	.hidden { display: none !important; }

	.empty { color: var(--text-muted); }

	/* ── Lightbox ─────────────────────────────────── */
	dialog {
		max-width: min(90vw, 1000px);
		padding: 1em;
		background: var(--bg-alt);
		color: var(--text);
		border: 1.5px solid var(--border);
		border-radius: 12px;
	}
	dialog::backdrop {
		background: rgba(4, 8, 16, 0.75);
	}
	dialog img {
		display: block;
		max-width: 100%;
		max-height: 70vh;
		margin: 0 auto;
		border-radius: 8px;
	}
	.close {
		position: absolute;
		top: 0.4em;
		right: 0.5em;
		padding: 0 0.35em;
		background: var(--bg);
		border: 1.5px solid var(--border);
		border-radius: 8px;
		color: var(--text);
		font-size: 1.25em;
		line-height: 1.4;
		cursor: pointer;
	}
	.info { padding: 0.75em 0.25em 0; }
	.lb-title { font-size: 1.25em; margin-bottom: 0.25rem; }
	.lb-description { margin: 0 0 0.25em; font-size: 0.9em; }
	.lb-meta { margin: 0; color: var(--text-muted); font-size: 0.8em; }

	@media (max-width: 720px) {
		.stack-item {
			flex-direction: column !important;
		}
		.stack-img { flex: unset; width: 100%; }
		.stack-info { padding: 1.25em 1em 1.5em; }
	}
</style>

<script>
	const stackLayout = document.getElementById('stack-layout');
	const gridLayout = document.getElementById('grid-layout');
	const btns = document.querySelectorAll<HTMLButtonElement>('.layout-btn');

	function setLayout(layout: 'grid' | 'stack') {
		stackLayout?.classList.toggle('hidden', layout !== 'stack');
		gridLayout?.classList.toggle('hidden', layout !== 'grid');
		btns.forEach((b) => {
			const isActive = b.dataset.layout === layout;
			b.classList.toggle('active', isActive);
			b.setAttribute('aria-pressed', String(isActive));
		});
		localStorage.setItem('gallery-layout-v2', layout);
	}

	const savedLayout = (localStorage.getItem('gallery-layout-v2') ?? 'grid') as 'grid' | 'stack';
	if (savedLayout !== 'grid') setLayout(savedLayout);

	btns.forEach((btn) => {
		btn.addEventListener('click', () => setLayout(btn.dataset.layout as 'grid' | 'stack'));
	});

	// Lightbox — stack items
	const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
	if (lightbox) {
		const img = lightbox.querySelector('img')!;
		const title = lightbox.querySelector('.lb-title')!;
		const description = lightbox.querySelector('.lb-description')!;
		const meta = lightbox.querySelector('.lb-meta')!;

		function openLightbox(card: HTMLElement) {
			img.src = card.dataset.full ?? '';
			img.alt = card.dataset.alt ?? '';
			title.textContent = card.dataset.title ?? '';
			description.textContent = card.dataset.description ?? '';
			meta.textContent = card.dataset.meta ?? '';
			lightbox!.showModal();
		}

		document.querySelectorAll<HTMLElement>('.stack-item').forEach((el) =>
			el.addEventListener('click', () => openLightbox(el))
		);
		document.querySelectorAll<HTMLElement>('.gallery-card').forEach((el) =>
			el.addEventListener('click', () => openLightbox(el))
		);

		lightbox.querySelector('.close')?.addEventListener('click', () => lightbox.close());
		lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close(); });
	}
</script>
