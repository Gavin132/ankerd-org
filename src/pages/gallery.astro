---
import { getCollection } from 'astro:content';
import GalleryCard from '../components/GalleryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const photos = (await getCollection('gallery')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={`Gallery — ${SITE_TITLE}`} description="Photography by ankerd." wide>
	<h1>Gallery</h1>
	{
		photos.length > 0 ? (
			<div class="grid">
				{photos.map((entry) => (
					<GalleryCard entry={entry} />
				))}
			</div>
		) : (
			<p class="empty">No photos yet — add entries to <code>src/content/gallery/</code>.</p>
		)
	}

	<dialog id="lightbox">
		<button class="close" aria-label="Close">&times;</button>
		<img alt="" />
		<div class="info">
			<h2 class="lb-title"></h2>
			<p class="lb-description"></p>
			<p class="lb-meta"></p>
		</div>
	</dialog>
</BaseLayout>
<style>
	h1 {
		font-size: 2.441em;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.25em;
	}
	.empty {
		color: var(--text-muted);
	}

	dialog {
		max-width: min(90vw, 1000px);
		padding: 1em;
		background: var(--bg-alt);
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: 12px;
	}
	dialog::backdrop {
		background: rgba(4, 8, 16, 0.75);
		backdrop-filter: blur(4px);
	}
	dialog img {
		display: block;
		max-width: 100%;
		max-height: 70vh;
		margin: 0 auto;
		border-radius: 8px;
	}
	.close {
		position: absolute;
		top: 0.4em;
		right: 0.5em;
		padding: 0 0.35em;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text);
		font-size: 1.25em;
		line-height: 1.4;
		cursor: pointer;
	}
	.info {
		padding: 0.75em 0.25em 0;
	}
	.lb-title {
		font-size: 1.25em;
		margin-bottom: 0.25rem;
	}
	.lb-description {
		margin: 0 0 0.25em;
		font-size: 0.9em;
	}
	.lb-meta {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8em;
	}
</style>
<script>
	const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
	if (lightbox) {
		const img = lightbox.querySelector('img')!;
		const title = lightbox.querySelector('.lb-title')!;
		const description = lightbox.querySelector('.lb-description')!;
		const meta = lightbox.querySelector('.lb-meta')!;

		document.querySelectorAll<HTMLButtonElement>('.gallery-card').forEach((card) => {
			card.addEventListener('click', () => {
				img.src = card.dataset.full ?? '';
				img.alt = card.dataset.alt ?? '';
				title.textContent = card.dataset.title ?? '';
				description.textContent = card.dataset.description ?? '';
				meta.textContent = card.dataset.meta ?? '';
				lightbox.showModal();
			});
		});

		lightbox.querySelector('.close')?.addEventListener('click', () => lightbox.close());
		// Clicking the backdrop (the dialog element itself) closes; Esc works natively.
		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) lightbox.close();
		});
	}
</script>
