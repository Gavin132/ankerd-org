---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../consts';

const socialIconMap: Record<string, string> = {
	YouTube: 'simple-icons:youtube',
	GitHub: 'simple-icons:github',
	Twitter: 'simple-icons:x',
	Instagram: 'simple-icons:instagram',
};

const otherSites = [
	{
		href: 'https://status.ankerd.org',
		name: 'status.ankerd.org',
		text: 'The live status page. Check whether our websites and services are up.',
	},
	{
		href: 'https://pws.ankerd.nl',
		name: 'pws.ankerd.nl',
		text: 'There is a Mandelbrot set simulation available on this website. It was made using the Unity game engine. The simulation was created for a report on complex numbers.',
	},
	{
		href: 'https://soc.ankerd.nl',
		name: 'soc.ankerd.nl',
		text: 'Stupid chemistry jokes. The jokes have all been lost in translation. This website was used for an osu! tournament back in the day, nowadays this website is kind of neglected.',
	},
];
---

<BaseLayout title="Contact — ankerd" description="Get in touch with ankerd.">
	<h1>Contact us</h1>
	<p class="lead">
		If you'd like to reach out to us, please send us an email! We'll contact you within a few
		business days. Our email address is{' '}
		<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. We're looking forward to receiving your
		messages!
	</p>

	<ul class="socials">
		{
			SOCIAL_LINKS.map(({ label, href }) => (
				<li>
					<a href={href} target="_blank" rel="noopener">
						{socialIconMap[label] && (
							<Icon name={socialIconMap[label]} width="18" height="18" aria-hidden="true" />
						)}
						{label}
					</a>
				</li>
			))
		}
	</ul>

	<h2>Our other websites</h2>
	<ul class="sites">
		{
			otherSites.map((site) => (
				<li>
					<a href={site.href} target="_blank" rel="noopener">
						{site.name}
					</a>
					<p>{site.text}</p>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	h1 {
		font-size: 2.441em;
	}
	.lead {
		color: var(--text-muted);
		line-height: 1.7;
	}
	.socials {
		list-style: none;
		padding: 0;
		margin: 1.5em 0 2.5em;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 1em;
		border: 1.5px solid var(--border);
		border-radius: 999px;
		font-size: 0.9em;
		text-decoration: none;
		color: var(--text);
	}
	.socials a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.sites {
		list-style: none;
		padding: 0;
	}
	.sites li {
		padding: 1em 0;
		border-top: 1.5px solid var(--border);
	}
	.sites p {
		margin: 0.4em 0 0;
		color: var(--text-muted);
		font-size: 0.9em;
	}
</style>
