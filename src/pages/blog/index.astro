---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
---

<BaseLayout title={`Blog — ${SITE_TITLE}`} description="Blog posts by ankerd." wide>
	<h1 data-animate>Blog</h1>

	{posts.length > 0 ? (
		<div class="blog-list">
			{featured && (
				<a class="post-feature" href={`/blog/${featured.id}/`} data-animate>
					{featured.data.heroImage ? (
						<Image
							class="post-feature__img"
							src={featured.data.heroImage}
							alt={featured.data.title}
							widths={[800, 1400]}
							sizes="(min-width: 720px) calc(100vw - 200px), 100vw"
							loading="eager"
						/>
					) : (
						<div class="post-feature__img post-feature__img--empty" />
					)}
					<div class="post-feature__body">
						<span class="post-feature__label">Latest</span>
						<h2 class="post-feature__title">{featured.data.title}</h2>
						{featured.data.description && (
							<p class="post-feature__desc">{featured.data.description}</p>
						)}
						<span class="post-feature__date"><FormattedDate date={featured.data.pubDate} /></span>
					</div>
				</a>
			)}

			{rest.length > 0 && (
				<div class="post-grid">
					{rest.map((post, i) => (
						<a class="post-card" href={`/blog/${post.id}/`} data-animate data-delay={i + 1}>
							{post.data.heroImage ? (
								<Image
									class="post-card__img"
									src={post.data.heroImage}
									alt={post.data.title}
									widths={[400, 800]}
									sizes="(max-width: 640px) 100vw, (min-width: 720px) calc(25vw - 2em), 50vw"
									loading="lazy"
								/>
							) : (
								<div class="post-card__img post-card__img--empty" />
							)}
							<div class="post-card__overlay">
								<h3 class="post-card__title">{post.data.title}</h3>
								<span class="post-card__date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					))}
				</div>
			)}
		</div>
	) : (
		<p class="empty">No posts yet.</p>
	)}
</BaseLayout>

<style>
	h1 {
		font-size: 2.441em;
		margin-bottom: 1.5em;
	}
	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 1em;
	}
	.empty { color: var(--text-muted); }

	/* Featured post — full-width magazine cover */
	.post-feature {
		position: relative;
		display: block;
		border-radius: 16px;
		overflow: hidden;
		height: 480px;
		text-decoration: none;
		background: var(--bg-alt);
	}
	.post-feature__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
		transition: transform 0.5s ease;
	}
	.post-feature__img--empty { background: var(--bg-alt); }
	.post-feature:hover .post-feature__img { transform: scale(1.03); }
	.post-feature__body {
		position: absolute;
		bottom: 0; left: 0; right: 0;
		padding: 2.5em 2em 2em;
		background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 50%, transparent 100%);
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.post-feature__label {
		font-size: 0.65em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--accent);
	}
	.post-feature__title {
		font-size: 1.9em;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: #fff;
		margin: 0;
	}
	.post-feature__desc {
		font-size: 0.9em;
		color: rgba(255,255,255,0.72);
		margin: 0.2em 0 0;
		line-height: 1.5;
		max-width: 60ch;
	}
	.post-feature__date {
		font-size: 0.75em;
		color: rgba(255,255,255,0.5);
		margin-top: 0.25em;
	}

	/* Post grid — overlay cards */
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0.8em;
	}
	.post-card {
		position: relative;
		display: block;
		height: 240px;
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		background: var(--bg-alt);
	}
	.post-card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
		transition: transform 0.5s ease;
	}
	.post-card__img--empty { background: var(--bg-alt); }
	.post-card:hover .post-card__img { transform: scale(1.04); }
	.post-card__overlay {
		position: absolute;
		bottom: 0; left: 0; right: 0;
		padding: 1.5em 1.1em 1em;
		background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.4) 55%, transparent 100%);
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}
	.post-card__title {
		font-size: 0.95em;
		font-weight: 700;
		line-height: 1.3;
		color: #fff;
		margin: 0;
	}
	.post-card__date {
		font-size: 0.72em;
		color: rgba(255,255,255,0.5);
	}

	@media (max-width: 640px) {
		.post-feature { height: 320px; }
		.post-feature__title { font-size: 1.4em; }
		.post-feature__desc { display: none; }
		.post-card { height: 200px; }
	}
</style>
