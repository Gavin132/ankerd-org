---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import VideoCard from '../components/VideoCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecentVideos } from '../lib/youtube';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const photos = (await getCollection('gallery'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
const videos = (await getRecentVideos())?.slice(0, 3) ?? null;
---

<BaseLayout>
	<section class="hero">
		<h1 class="gradient-text">ankerd</h1>
		<p class="tagline">Writing, videos, and photography — collected in one place.</p>
	</section>

	<section>
		<header>
			<h2>Latest posts</h2>
			<a class="view-all" href="/blog">View all →</a>
		</header>
		{
			posts.length > 0 ? (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))}
				</ul>
			) : (
				<p class="muted">No posts yet.</p>
			)
		}
	</section>

	<section>
		<header>
			<h2>Recent videos</h2>
			<a class="view-all" href="/videos">View all →</a>
		</header>
		{
			videos && videos.length > 0 ? (
				<div class="video-grid">
					{videos.map((video) => (
						<VideoCard video={video} />
					))}
				</div>
			) : (
				<p class="muted">Videos are coming soon.</p>
			)
		}
	</section>

	<section>
		<header>
			<h2>From the gallery</h2>
			<a class="view-all" href="/gallery">View all →</a>
		</header>
		{
			photos.length > 0 ? (
				<div class="photo-grid">
					{photos.map((photo) => (
						<a href="/gallery" aria-label={photo.data.title}>
							<Image
								src={photo.data.photo}
								alt={photo.data.alt}
								widths={[300, 600]}
								sizes="(max-width: 720px) 33vw, 230px"
							/>
						</a>
					))}
				</div>
			) : (
				<p class="muted">No photos yet.</p>
			)
		}
	</section>
</BaseLayout>
<style>
	.hero {
		padding: 0.5em 0 1em;
	}
	.hero h1 {
		font-size: 3.6em;
		margin-bottom: 0.25rem;
	}
	.tagline {
		color: var(--text-muted);
		font-size: 1.05em;
	}
	section + section {
		margin-top: 2.5em;
	}
	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 0.75em;
	}
	header h2 {
		font-size: 1.45em;
		margin: 0;
	}
	.view-all {
		font-size: 0.8em;
		text-decoration: none;
		white-space: nowrap;
	}
	.muted {
		color: var(--text-muted);
		margin: 0;
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		padding: 0.45em 0;
		border-bottom: 1px solid var(--border);
	}
	.posts a {
		text-decoration: none;
	}
	.posts .date {
		color: var(--text-muted);
		font-size: 0.8em;
		white-space: nowrap;
	}
	.video-grid,
	.photo-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1em;
	}
	.photo-grid img {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 10px;
		transition: box-shadow 0.2s ease;
	}
	.photo-grid a:hover img {
		box-shadow: var(--shadow);
	}
	@media (max-width: 720px) {
		.video-grid {
			grid-template-columns: 1fr;
		}
		.photo-grid {
			gap: 0.5em;
		}
	}
</style>
