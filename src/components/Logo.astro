---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 130 32"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="ankerd"
>
	<defs>
		<linearGradient id="ankerd-gradient" x1="0" y1="0" x2="1" y2="0">
			<stop offset="0%" stop-color="#0EA5E9"></stop>
			<stop offset="33%" stop-color="#38BDF8"></stop>
			<stop offset="66%" stop-color="#7DD3FC"></stop>
			<stop offset="100%" stop-color="#BAE6FD"></stop>
		</linearGradient>
	</defs>
	<text
		x="0"
		y="24"
		font-family="var(--font-atkinson), sans-serif"
		font-size="24"
		font-weight="700"
		letter-spacing="3"
		fill="url(#ankerd-gradient)">ANKERD</text
	>
</svg>
