---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 130 32"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="ankerd"
>
	<text
		x="0"
		y="24"
		font-family="var(--font-poppins), sans-serif"
		font-size="26"
		font-weight="700"
		letter-spacing="0.5"
		style="fill: var(--accent)">ankerd</text
	>
</svg>
