---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Video } from '../lib/youtube';
import FormattedDate from './FormattedDate.astro';

interface Props {
	video: Video;
	short?: boolean;
	loading?: 'eager' | 'lazy';
}

const { video, short = false, loading = 'lazy' } = Astro.props;
---

<a class:list={['video-card', { short }]} href={video.url} target="_blank" rel="noopener">
	<div class="thumb-wrap">
		<Image
			src={video.thumbnail}
			alt={video.title}
			width={640}
			height={360}
			inferSize
			loading={loading}
			class="thumb-img"
		/>
		<div class="thumb-overlay">
			<div class="play-circle">
				<Icon name="lucide:play" width="24" height="24" aria-hidden="true" />
			</div>
		</div>
	</div>
	<h3 class="title">{video.title}</h3>
	<p class="date"><FormattedDate date={video.publishedAt} /></p>
</a>

<style>
	.video-card {
		display: block;
		text-decoration: none;
		color: var(--text);
	}
	.thumb-wrap {
		position: relative;
		border-radius: 14px;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: var(--bg-alt);
		border: 1px solid var(--border);
	}
	.short .thumb-wrap {
		aspect-ratio: 9 / 16;
	}
	.thumb-img {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover;
		display: block;
		border-radius: 0;
		transition: transform 0.4s ease;
	}
	.video-card:hover .thumb-img { transform: scale(1.04); }

	.thumb-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, transparent 55%);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.play-circle {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: rgba(255,255,255,0.12);
		border: 2px solid rgba(255,255,255,0.55);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		backdrop-filter: blur(4px);
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}
	.video-card:hover .play-circle {
		background: var(--accent);
		border-color: var(--accent);
		transform: scale(1.1);
	}
	.title {
		margin: 0.6em 0 0;
		font-size: 0.9em;
		font-weight: 600;
		line-height: 1.35;
		color: var(--text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.video-card:hover .title {
		color: var(--accent);
	}
	.short .title {
		font-size: 0.8em;
	}
	.date {
		margin: 0.25em 0 0;
		color: var(--text-muted);
		font-size: 0.78em;
	}
</style>
