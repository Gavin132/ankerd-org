---
import type { Video } from '../lib/youtube';
import FormattedDate from './FormattedDate.astro';

interface Props {
	video: Video;
}

const { video } = Astro.props;
---

<a class="video-card" href={video.url} target="_blank" rel="noopener">
	<img src={video.thumbnail} alt="" loading="lazy" width="480" height="270" />
	<h3 class="title">{video.title}</h3>
	<p class="date"><FormattedDate date={video.publishedAt} /></p>
</a>

<style>
	.video-card {
		display: block;
		color: var(--text);
		text-decoration: none;
	}
	.video-card img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 12px;
		transition: box-shadow 0.2s ease;
	}
	.video-card:hover img {
		box-shadow: var(--shadow);
	}
	.title {
		margin: 0.5rem 0 0.15rem;
		font-size: 1em;
		line-height: 1.3;
	}
	.video-card:hover .title {
		color: var(--accent);
	}
	.date {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8em;
	}
</style>
