---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<aside class="sidebar">
	<div class="sidebar-top">
		<a href="/" class="logo-link" aria-label={`${SITE_TITLE} — home`}>
			<Logo class="logo" />
		</a>
		<div class="mobile-controls">
			<ThemeToggle />
			<button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
				<svg
					viewBox="0 0 24 24"
					width="22"
					height="22"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</div>
	<nav id="site-nav">
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/videos">Videos</HeaderLink>
		<HeaderLink href="/gallery">Gallery</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
	</nav>
	<div class="sidebar-bottom">
		<ThemeToggle />
		<div class="social-links">
			{
				SOCIAL_LINKS.map(({ label, href }) => (
					<a href={href} target="_blank" rel="noopener">
						{label}
					</a>
				))
			}
		</div>
	</div>
</aside>

<style>
	.sidebar {
		width: var(--sidebar-width);
		flex-shrink: 0;
		position: sticky;
		top: 0;
		height: 100vh;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 2em;
		padding: 1.5em 1.25em;
		background: var(--bg-alt);
		border-right: 1px solid var(--border);
	}
	.logo-link {
		display: block;
	}
	.logo-link :global(.logo) {
		width: 130px;
		height: auto;
		display: block;
	}
	.mobile-controls {
		display: none;
	}
	nav {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}
	.sidebar-bottom {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 1em;
		align-items: flex-start;
	}
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	.social-links a {
		color: var(--text-muted);
		font-size: 0.75em;
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.sidebar {
			width: 100%;
			height: auto;
			gap: 0;
			padding: 0.6em 1em;
			border-right: none;
			border-bottom: 1px solid var(--border);
			z-index: 10;
		}
		.sidebar-top {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}
		.logo-link :global(.logo) {
			width: 100px;
		}
		.mobile-controls {
			display: flex;
			align-items: center;
			gap: 0.5em;
		}
		.menu-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.5em;
			background: none;
			border: 1px solid var(--border);
			border-radius: 8px;
			color: var(--text-muted);
			cursor: pointer;
		}
		.menu-toggle:hover {
			color: var(--accent);
			border-color: var(--accent);
		}
		nav {
			display: none;
			padding-top: 0.75em;
		}
		.sidebar.open nav {
			display: flex;
		}
		.sidebar-bottom {
			display: none;
		}
	}
</style>

<script>
	const sidebar = document.querySelector('.sidebar');
	const menuToggle = document.querySelector('.menu-toggle');
	menuToggle?.addEventListener('click', () => {
		const open = sidebar?.classList.toggle('open') ?? false;
		menuToggle.setAttribute('aria-expanded', String(open));
	});
	sidebar?.querySelectorAll('nav a').forEach((link) => {
		link.addEventListener('click', () => {
			sidebar.classList.remove('open');
			menuToggle?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
